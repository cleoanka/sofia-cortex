{
  "expo": {
    "name": "Sofia Cortex",
    "slug": "sofia-cortex",
    "scheme": "sofia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#090A0C",
    "ios": {
      "bundleIdentifier": "com.cleoanka.sofiacortex",
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "Telefonu sallayarak son işlemi geri almak için."
      },
      "appleTeamId": "3UBX7U87GG"
    },
    "android": {
      "package": "com.cleoanka.sofiacortex",
      "adaptiveIcon": {
        "backgroundColor": "#090A0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withLocalNotificationsOnly",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#F2A33A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 220,
          "backgroundColor": "#FBF9F5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#090A0C"
          }
        }
      ]
    ]
  }
}